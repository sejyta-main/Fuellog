+// ── navel circumference tracking ─────────────────────────────
+function renderNavel(){
+  const pts=[...measurements].sort((a,b)=>a.date.localeCompare(b.date)).slice(-12);
+  const svg=$("chNavel"), cap=$("chNavelCap"), list=$("navelList");
+  if(pts.length<2){
+    svg.innerHTML="";
+    cap.textContent=pts.length?`Latest: ${(+pts[0].navel).toFixed(1)} cm · add another measurement to see the trend.`:"Log your first navel measurement. Weekly is enough.";
+  } else {
+    const vals=pts.map(p=>+p.navel);
+    const sm=vals.map((v,i)=>{ const w=vals.slice(Math.max(0,i-2),i+1); return w.reduce((a,b)=>a+b,0)/w.length; });
+    let mn=Math.min(...vals,...sm)-0.8, mx=Math.max(...vals,...sm)+0.8;
+    if(mx-mn<2){ const mid=(mx+mn)/2; mn=mid-1; mx=mid+1; }
+    const X=i=>(i/(pts.length-1))*300, Y=v=>100-((v-mn)/(mx-mn))*88-6;
+    let out="";
+    pts.forEach((p,i)=>{ out+=`<circle cx="${X(i).toFixed(1)}" cy="${Y(+p.navel).toFixed(1)}" r="2.8" fill="#9AA6C0"/>`; });
+    out+=`<path d="${sm.map((v,i)=>`${i?"L":"M"}${X(i).toFixed(1)},${Y(v).toFixed(1)}`).join(" ")}" fill="none" stroke="var(--blue)" stroke-width="2.5" stroke-linecap="round"/>`;
+    svg.innerHTML=out;
+    const d=vals[vals.length-1]-vals[0];
+    cap.textContent=`Dots = measurements · Blue = 3-reading trend · ${pts[0].date.slice(5)} → ${pts[pts.length-1].date.slice(5)} · ${d>0?"+":""}${d.toFixed(1)} cm`;
+  }
+  const recent=[...measurements].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,8);
+  list.innerHTML=recent.map(m=>`<div class="meal"><span style="font-weight:600;font-size:14px">${m.date.slice(5)}</span><span style="display:flex;align-items:center;gap:4px"><b>${(+m.navel).toFixed(1)} cm</b><button class="del" data-ndel="${m.date}" aria-label="Delete navel measurement ${m.date}">✕</button></span></div>`).join("");
+}
+$("navelLog").onclick=()=>{
