+  measurements=[...measurements.filter(m=>m.date!==date),{date,navel:Math.round(n*10)/10}].sort((a,b)=>a.date.localeCompare(b.date));
+  save("fl:measurements",measurements); $("navelIn").value=""; renderNavel(); toast("Navel measurement logged");
